{
  "name": "media-library-api",
  "version": "1.0.0",
  "description": "Production-grade Media Library API built with Express, Prisma, Zod and Multer",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch server.js",
    "start": "NODE_ENV=production node server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:test": "NODE_ENV=test prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:postman": "node postman/generate-large-fixture.js && newman run postman/media-library-api.postman_collection.json -e postman/local.postman_environment.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "newman": "^6.2.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  }
}
