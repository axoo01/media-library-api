              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "        const { results, count } = pm.response.json().data;",
                  "        pm.test('Both files are saved with titles from their filenames', () => {",
                  "          pm.expect(count).to.eql(2);",
                  "          results.forEach((r) => pm.expect(r.title).to.eql('sample'));",
                  "          pm.expect(results.map((r) => r.mimeType)).to.have.members(['image/jpeg', 'application/pdf']);",
                  "        });",
                  "        ",
                  "pm.test('Media has all required fields', () => {",
                  "  pm.expect(results[0]).to.include.all.keys('id', 'title', 'filePath', 'originalName', 'mimeType', 'fileSize', 'tags', 'category', 'createdAt', 'updatedAt');",
                  "});",
                  "        pm.collectionVariables.set('BULK_ID_1', results[0].id);",
                  "        pm.collectionVariables.set('BULK_ID_2', results[1].id);"
                ]
              }
            }
          ],
