            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/{{bulkId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["media", "{{bulkId2}}"]
            }
          }
        }
      ]
    },
