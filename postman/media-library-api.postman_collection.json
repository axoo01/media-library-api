{
  "info": {
    "name": "Media Library API",
    "description": "Endpoint and edge-case tests for the Media Library API.\n\nSelect the Development or Production environment (both define BASE_URL and MEDIA_ID). Run the \"Media lifecycle\" folder in order: \"Upload media\" stores MEDIA_ID in the active environment for the requests after it, and the lifecycle deletes everything it creates.\n\nFile uploads use paths relative to the project root: run Newman from there (npm run test:postman / npm run test:postman:prod) or set Postman's working directory to the project root. The oversized fixture is generated by postman/generate-large-fixture.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BULK_ID_1",
      "value": ""
    },
    {
      "key": "BULK_ID_2",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared checks for every request. /health has its own contract, and a gateway 413",
          "// (Vercel's 4.5MB request limit) is not produced by the API, so neither uses the envelope.",
          "const isJson = (pm.response.headers.get('Content-Type') || '').includes('application/json');",
          "const isHealth = pm.request.url.getPath() === '/health';",
          "const isGatewayLimit = pm.response.code === 413 && !isJson;",
          "",
          "if (!isHealth && !isGatewayLimit) {",
          "  pm.test('Response is JSON', () => pm.expect(isJson).to.be.true);",
          "  pm.test('Response uses the standard envelope', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body.status).to.be.oneOf(['success', 'error']);",
          "    if (body.status === 'success') {",
          "      pm.expect(body).to.have.property('data');",
          "    } else {",
          "      pm.expect(body.message).to.be.a('string').and.not.empty;",
          "      pm.expect(body.details).to.be.an('array');",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "        const body = pm.response.json();",
                  "        pm.test('Body is { status: \"ok\", uptime, timestamp }', () => {",
                  "          pm.expect(body).to.have.all.keys('status', 'uptime', 'timestamp');",
                  "          pm.expect(body.status).to.eql('ok');",
                  "          pm.expect(body.uptime).to.be.a('number').and.to.be.at.least(0);",
                  "          pm.expect(new Date(body.timestamp).toISOString()).to.eql(body.timestamp);",
                  "        });",
                  "        pm.test('Health responses are not cached', () => pm.response.to.have.header('Cache-Control', 'no-store'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": ["{{BASE_URL}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Media lifecycle",
      "description": "Happy path, in order: upload, bulk upload, list, filter, get, update, delete.",
      "item": [
        {
          "name": "Upload media",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "        const { media } = pm.response.json().data;",
                  "        ",
                  "pm.test('Media has all required fields', () => {",
                  "  pm.expect(media).to.include.all.keys('id', 'title', 'filePath', 'originalName', 'mimeType', 'fileSize', 'tags', 'category', 'createdAt', 'updatedAt');",
                  "});",
                  "        pm.test('Metadata is stored and normalized', () => {",
                  "          pm.expect(media.title).to.eql('Postman sunset');",
                  "          pm.expect(media.tags).to.eql(['postman', 'beach', 'summer']);",
                  "          pm.expect(media.category).to.eql('IMAGE');",
                  "          pm.expect(media.mimeType).to.eql('image/png');",
                  "          pm.expect(media.originalName).to.eql('sample.png');",
                  "          pm.expect(media.fileSize).to.be.above(0);",
                  "          pm.expect(media.filePath).to.match(/[0-9a-f-]{36}\\.png$/);",
                  "        });",
                  "        pm.environment.set('MEDIA_ID', media.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/media",
              "host": ["{{BASE_URL}}"],
              "path": ["media"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "postman/fixtures/sample.png"
                },
                {
                  "key": "title",
                  "value": "Postman sunset",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "Postman, Beach,summer",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "image",
                  "type": "text"
                }
              ]
            }
          }
        },
