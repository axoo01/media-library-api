                  "        pm.test('Pagination metadata has total, page, limit and totalPages', () => {",
                  "          pm.expect(pagination).to.have.all.keys('total', 'page', 'limit', 'totalPages');",
                  "          pm.expect(pagination).to.include({ page: 1, limit: 10 });",
                  "          pm.expect(pagination.totalPages).to.eql(Math.ceil(pagination.total / 10));",
                  "          pm.expect(results.length).to.be.at.most(10);",
                  "        });",
                  "        ",
                  "pm.test('Media has all required fields', () => {",
                  "  pm.expect(results[0]).to.include.all.keys('id', 'title', 'filePath', 'originalName', 'mimeType', 'fileSize', 'tags', 'category', 'createdAt', 'updatedAt');",
                  "});"
                ]
