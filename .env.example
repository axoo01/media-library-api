# Copy to .env.development, .env.test and .env.production (all git-ignored) and fill in values.
# dotenv-flow loads .env.<NODE_ENV>; variables already set in the environment (CI, Vercel) win.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# PostgreSQL connection URL (UTF-8 database). In test it must end with _test, e.g. media_library_test
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_library"

# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Maximum upload size per file, in megabytes
MAX_FILE_SIZE_MB=5

# Upload directory: relative to the project root, or absolute (use /tmp/uploads on Vercel)
UPLOAD_DIR=uploads

# debug | info | warn | error (silent is also accepted, e.g. for tests)
LOG_LEVEL=info

# Optional: max time (ms) to finish in-flight requests on shutdown before forcing exit
# SHUTDOWN_TIMEOUT_MS=10000

# Optional: only needed if your Postgres cluster's default encoding is not UTF-8
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_library_shadow"
