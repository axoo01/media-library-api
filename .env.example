# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Max time (ms) to wait for in-flight requests during graceful shutdown before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL connection URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_library"

# Optional: only needed if your Postgres cluster's default encoding is not UTF-8
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media_library_shadow"

# Directory for uploaded files, relative to the project root
UPLOAD_DIR=uploads
